src/aliox/template.i: src/aliox/template.cpp.i
.PHONY : src/aliox/template.i

# target to preprocess a source file
src/aliox/template.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/aliox.dir/build.make CMakeFiles/aliox.dir/src/aliox/template.cpp.i
.PHONY : src/aliox/template.cpp.i

src/aliox/template.s: src/aliox/template.cpp.s
.PHONY : src/aliox/template.s

# target to generate assembly for a file
src/aliox/template.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/aliox.dir/build.make CMakeFiles/aliox.dir/src/aliox/template.cpp.s
.PHONY : src/aliox/template.cpp.s

